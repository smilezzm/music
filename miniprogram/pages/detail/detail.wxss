.container {
  padding-bottom: 160rpx;
}

/* Cover */
.detail-cover {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.status-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-upcoming { background-color: #07C160; }
.status-ongoing { background-color: #1989fa; }
.status-ended { background-color: #c8c9cc; }

/* Info section */
.detail-info {
  margin-top: -40rpx;
  position: relative;
  z-index: 1;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.info-text {
  font-size: 28rpx;
  color: #666;
}

/* Description */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.desc-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* Action buttons */
.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  z-index: 50;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
  background: none;
  border: none;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.action-text {
  font-size: 20rpx;
  color: #666;
}

.action-main {
  flex: 1;
  margin-left: 24rpx;
}

.btn-primary-large {
  background-color: #07C160;
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  text-align: center;
}

.btn-danger-large {
  background-color: #ee0a24;
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  text-align: center;
}

.btn-disabled-large {
  background-color: #c8c9cc;
  color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  text-align: center;
}

/* Loading */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}

.text-danger {
  color: #ee0a24;
}
