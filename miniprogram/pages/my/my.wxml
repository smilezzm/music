<view class="container">
  <!-- Tab bar -->
  <view class="tab-bar">
    <view 
      class="tab-item {{activeTab === 'registrations' ? 'tab-active' : ''}}" 
      data-tab="registrations"
      bindtap="onTabChange"
    >
      <text>我的报名</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'favorites' ? 'tab-active' : ''}}" 
      data-tab="favorites"
      bindtap="onTabChange"
    >
      <text>我的收藏</text>
    </view>
  </view>

  <!-- Admin entry -->
  <view class="admin-entry" wx:if="{{isAdmin}}" bindtap="goToAdmin">
    <text>🔧 管理后台</text>
    <text class="admin-arrow">›</text>
  </view>

  <!-- Registrations tab -->
  <view class="tab-content" wx:if="{{activeTab === 'registrations'}}">
    <view class="list-item" wx:for="{{registrations}}" wx:key="_id" data-id="{{item.activityId}}" bindtap="goToDetail">
      <view class="item-cover">
        <image src="{{item.activityCover || '/images/default-cover.png'}}" mode="aspectFill" class="item-image"/>
      </view>
      <view class="item-info">
        <view class="item-title">{{item.activityTitle || '活动'}}</view>
        <view class="item-meta">
          <text class="meta-icon">📅</text>
          <text>{{item.activityDate || ''}}</text>
        </view>
        <view class="item-meta">
          <text class="meta-icon">📍</text>
          <text>{{item.activityLocation || ''}}</text>
        </view>
        <view class="item-time">报名时间: {{item.createdAt || ''}}</view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{regEmpty && !regLoading}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无报名记录</text>
    </view>

    <view class="loading-more" wx:if="{{regLoading}}">加载中...</view>
    <view class="loading-more" wx:if="{{!regHasMore && registrations.length > 0}}">— 没有更多了 —</view>
  </view>

  <!-- Favorites tab -->
  <view class="tab-content" wx:if="{{activeTab === 'favorites'}}">
    <view class="list-item" wx:for="{{favorites}}" wx:key="_id" data-id="{{item.activityId}}" bindtap="goToDetail">
      <view class="item-cover">
        <image src="{{item.activityCover || '/images/default-cover.png'}}" mode="aspectFill" class="item-image"/>
      </view>
      <view class="item-info">
        <view class="item-title">{{item.activityTitle || '活动'}}</view>
        <view class="item-meta">
          <text class="meta-icon">📅</text>
          <text>{{item.activityDate || ''}}</text>
        </view>
        <view class="item-meta">
          <text class="meta-icon">📍</text>
          <text>{{item.activityLocation || ''}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{favEmpty && !favLoading}}">
      <text class="empty-icon">⭐</text>
      <text class="empty-text">暂无收藏</text>
    </view>

    <view class="loading-more" wx:if="{{favLoading}}">加载中...</view>
    <view class="loading-more" wx:if="{{!favHasMore && favorites.length > 0}}">— 没有更多了 —</view>
  </view>
</view>
