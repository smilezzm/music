<view class="container">
  <!-- Search bar -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <icon type="search" size="14" color="#999"></icon>
      <input 
        class="search-input" 
        placeholder="搜索活动" 
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</view>
    </view>
  </view>

  <!-- Filter tabs -->
  <view class="filter-bar">
    <view 
      class="filter-item {{currentFilter === item.key ? 'filter-active' : ''}}" 
      wx:for="{{filters}}" 
      wx:key="key"
      data-filter="{{item.key}}"
      bindtap="onFilterChange"
    >
      {{item.text}}
    </view>
  </view>

  <!-- Admin entry -->
  <view class="admin-entry" wx:if="{{isAdmin}}" bindtap="goToAdmin">
    <text>🔧 管理后台</text>
    <text class="admin-arrow">›</text>
  </view>

  <!-- Activity list -->
  <view class="activity-list">
    <activity-card 
      wx:for="{{activities}}" 
      wx:key="_id"
      activity="{{item}}"
      bind:activitytap="onActivityTap"
    />
  </view>

  <!-- Empty state -->
  <view class="empty-state" wx:if="{{isEmpty && !loading}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无活动</text>
  </view>

  <!-- Loading more -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- No more -->
  <view class="loading-more" wx:if="{{!hasMore && activities.length > 0 && !loading}}">
    <text>— 没有更多了 —</text>
  </view>
</view>
